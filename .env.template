# Jarvis Labs API token — generate at https://jarvislabs.ai/settings/api-keys
JARVIS_API_TOKEN=<token>

# Name of the instance to monitor and resume (as shown in your Jarvis Labs dashboard)
JARVIS_INSTANCE_NAME=<name-of-vm>

# Number of GPUs to request when resuming (default: 8)
NUM_GPUS=<1>

# GPU type (A100, A5000, A6000, RTX6000Ada, RTX5000)
GPU_TYPE=<type>

# Slack Bot token (xoxb-…) — create a Slack app at https://api.slack.com/apps and add chat:write scope
SLACK_BOT_TOKEN=<slack-token>

# Slack channel to post notifications to (channel name or ID, e.g. #gpu-alerts or C0123456789)
SLACK_CHANNEL=<channel-name>

# Seconds to wait between retry attempts after a failed resume (default: 30)
RETRY_COOLDOWN_SECONDS=<60>
